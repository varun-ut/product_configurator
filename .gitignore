# Claude Code scratch worktrees — never belong in the repo.
# NOTE: three of these are orphaned (their .git files point at a stale doubled
# path, D:/VARUN/Projects/product_configurator/product_configurator/...), which
# makes an unscoped `git status` abort. This ignore rule does NOT fix that —
# use `git status -- <path>` until those directories are removed by hand.
.claude/worktrees/

# Analytics database — real user event data (auth.db is already ignored above;
# this one was an oversight). Databases do not belong in the repo.
backend/analytics.db

# Chatbot request logs (token counts + hashed IPs, written per day).
backend/chatbot_logs/

# Separate static content site — ~114 MB of assets, built and deployed on its own.
content-site/
